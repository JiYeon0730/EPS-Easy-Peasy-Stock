# EPS v0.5 — 서버 전용 금융 API 키. 아래 값은 비워두거나 본인 키로 교체하세요.
# 이 파일은 예시만 담습니다. 실키는 .env.local에 저장하고 GitHub에 올리지 마세요.
FSC_STOCK_API_KEY=
FINNHUB_API_KEY=

# 원화 환산: Frankfurter USD/KRW 일별 기준 환율은 별도 키 없이 자동 조회합니다.

# 별도 활용신청이 필요한 금융위원회 KRX상장종목정보(옵션)
# 미설정 시 FSC_STOCK_API_KEY로 시도하며 승인되지 않았다면 추천 목록으로 대체
FSC_LIST_API_KEY=

# EPS v0.6 — Gemini Vision OCR. 서버에서만 사용하는 키입니다.
# Google AI Studio https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 안정 모델 기본값 gemini-3.8-flash (선택)
GEMINI_VISION_MODEL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
